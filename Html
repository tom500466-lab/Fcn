        }
        input[type=range]:focus {
            outline: none;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 10px;
            cursor: pointer;
            border-radius: 999px;
            background: linear-gradient(90deg, #f43f5e 0%, #f43f5e 35%, #f59e0b 35%, #f59e0b 40%, #10b981 40%, #3b82f6 70%, #8b5cf6 100%);
