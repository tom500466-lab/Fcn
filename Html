                                <line id="svgMarkerLine" x1="336" y1="20" x2="336" y2="250" stroke="#ffffff" stroke-width="1.5" />
                                <circle id="svgStockPoint" cx="336" cy="146" r="5" fill="#64748b" stroke="#ffffff" stroke-width="1.5" />
                                <circle id="svgFcnPoint" cx="336" cy="99" r="7" fill="#10b981" stroke="#ffffff" stroke-width="2" />
                            </svg>
