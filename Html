                                <line x1="50" y1="250" x2="580" y2="250" stroke="#334155" stroke-width="1.5" />
                                <text x="50" y="268" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="monospace">30%</text>
                                <text x="242.5" y="268" text-anchor="middle" fill="#fb7185" font-size="10" font-family="monospace">65%</text>
                                <text x="270" y="268" text-anchor="middle" fill="#fbbf24" font-size="10" font-family="monospace">70%</text>
                                <text x="435" y="268" text-anchor="middle" fill="#38bdf8" font-size="10" font-family="monospace">100%</text>
                                <text x="580" y="268" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="monospace">130%</text>

