                            <div class="flex items-center gap-4">
                                <span class="flex items-center gap-1.5"><span class="w-3 h-1 bg-indigo-400 inline-block rounded"></span> FCN 總報酬(含6個月配息)</span>
                                <span class="flex items-center gap-1.5"><span class="w-3 h-0.5 border-b border-dashed border-slate-400 inline-block"></span> 直接持有現股</span>
                            </div>
                        </div>
                        <div class="w-full overflow-hidden">
                            <svg id="payoffSvg" viewBox="0 0 600 290" class="w-full h-auto select-none">
                                <!-- Background Grid & Zones -->
                                <rect x="50" y="20" width="192.5" height="230" fill="rgba(244, 63, 94, 0.07)" />
                                <rect x="242.5" y="20" width="27.5" height="230" fill="rgba(245, 158, 11, 0.14)" />
                                <rect x="270" y="20" width="165" height="230" fill="rgba(16, 185, 129, 0.07)" />
                                <rect x="435" y="20" width="145" height="230" fill="rgba(56, 189, 248, 0.07)" />

                                <!-- Horizontal Reference Lines -->
                                <!-- 0% Profit Line (100% Principal) at y=110 -->
                                <line x1="50" y1="110" x2="580" y2="110" stroke="#475569" stroke-width="1" stroke-dasharray="4,4" />
                                <text x="44" y="114" text-anchor="end" fill="#94a3b8" font-size="10" font-family="monospace">0%</text>

                                <!-- +5.48% Max Return Line at y=94 -->
                                <line x1="50" y1="94" x2="580" y2="94" stroke="#10b981" stroke-width="1" stroke-dasharray="2,3" />
                                <text x="44" y="97" text-anchor="end" fill="#10b981" font-size="10" font-family="monospace">+5.5%</text>

                                <!-- Vertical Barrier Lines -->
                                <!-- 65% EKI Line: x = 50 + (65-30)*(550/100) = 50 + 35*5.5 = 242.5 -->
                                <line x1="242.5" y1="20" x2="242.5" y2="250" stroke="#f43f5e" stroke-width="1.5" stroke-dasharray="4,3" />
                                <text x="238" y="34" text-anchor="end" fill="#fb7185" font-size="10" font-weight="bold">EKI 65%</text>

                                <!-- 70% Strike Line: x = 50 + (70-30)*5.5 = 270 -->
                                <line x1="270" y1="20" x2="270" y2="250" stroke="#f59e0b" stroke-width="1.5" stroke-dasharray="4,3" />
                                <text x="274" y="34" text-anchor="start" fill="#fbbf24" font-size="10" font-weight="bold">轉換價 70%</text>

                                <!-- 100% KO Line: x = 50 + (100-30)*5.5 = 435 -->
                                <line x1="435" y1="20" x2="435" y2="250" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="4,3" />
                                <text x="439" y="34" text-anchor="start" fill="#38bdf8" font-size="10" font-weight="bold">KO 100%</text>

                                <!-- Direct Stock Holding Line (30% -> -70% at y=250; 100% -> 0% at y=110; 130% -> +30% at y=50) -->
                                <line x1="50" y1="250" x2="580" y2="54" stroke="#64748b" stroke-width="1.5" stroke-dasharray="5,5" />

                                <!-- FCN Payoff Curve -->
                                <!-- For WPS >= 65% (x from 242.5 to 580): Return is flat +5.48% (y=99) -->
                                <line x1="242.5" y1="99" x2="580" y2="99" stroke="#10b981" stroke-width="3.5" />
                                <!-- Cliff at 65% EKI (from y=99 down to net return at 64.9%: (65/70 - 1) + 5.48% = -7.14% + 5.48% = -1.66% -> y=113.3) -->
                                <line x1="242.5" y1="99" x2="242.5" y2="113.3" stroke="#f59e0b" stroke-width="2.5" stroke-dasharray="2,2" />
                                <!-- Below 65% (x from 50 to 242.5): Return at 30% is (30/70 - 1) + 5.48% = -57.14% + 5.48% = -51.66% -> y = 110 + 51.66*2 = 213.3 -->
                                <line x1="50" y1="213.3" x2="242.5" y2="113.3" stroke="#f43f5e" stroke-width="3.5" />

                                <!-- Zone Labels -->
                                <text x="145" y="242" text-anchor="middle" fill="#fda4af" font-size="10" font-weight="bold">跌破65%：70%轉換價接股</text>
                                <text x="256" y="75" text-anchor="middle" fill="#fcd34d" font-size="9" font-weight="bold">黃金緩衝</text>
                                <text x="352" y="242" text-anchor="middle" fill="#6ee7b7" font-size="10" font-weight="bold">70%~100%：安全領息保本</text>
                                <text x="508" y="242" text-anchor="middle" fill="#7dd3fc" font-size="10" font-weight="bold">≥100%：提前KO出場</text>

