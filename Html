    <script>
        // Product Constants (SNINR202610013)
        const PRODUCT = {
            code: 'SNINR202610013',
            tradeDate: '2026/10/15',
            underlyings: ['NVDA', 'AVGO', 'NOW'],
            tenorMonths: 6,
            annualCouponRate: 0.1096, // 10.96%
            monthlyCouponRate: 0.1096 / 12, // ~0.91333%
            total6MCouponRate: 0.1096 * 0.5, // 5.48%
            strikePct: 70, // 70%
            ekiPct: 65,    // 65% European KI
            koPct: 100     // 100% Memory KO after 1M
        };

        // Application State
        let state = {
            principal: 50000,
            wpsFinalPct: 82,
            // Memory KO Sandbox Matrix: 3 stocks x 6 months (boolean: did it touch >=100% in that month?)
            // Month 1 is non-call period (index 0)
            koMatrix: {
                NVDA: [true, true, false, false, false, false],
                AVGO: [false, false, true, false, false, false],
                NOW:  [false, false, true, true, false, false]
            }
        };

        // Format USD helper
        function formatUSD(num) {
            return '$' + Number(num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Tab Switching Logic
        function switchTab(tabId) {
            const tabs = ['simulator', 'memoryko', 'proscons', 'salespitch'];
            tabs.forEach(t => {
                const panel = document.getElementById('panel-' + t);
                const btn = document.getElementById('tab-' + t);
                if (t === tabId) {
                    panel.classList.remove('hidden');
                    btn.classList.add('tab-active');
                    btn.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-slate-800/60');
                } else {
                    panel.classList.add('hidden');
                    btn.classList.remove('tab-active');
                    btn.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-slate-800/60');
                }
            });
        }

        // Adjust Principal in increments of $10,000
        function adjustPrincipal(delta) {
            let nextVal = state.principal + delta;
            if (nextVal < 10000) nextVal = 10000;
            state.principal = nextVal;
            document.getElementById('principalInput').value = state.principal;
            refreshAllCalculations();
        }

        function onPrincipalInputChange(val) {
            let parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed < 10000) {
                parsed = 10000;
            } else {
                // Round to nearest 10,000 as required by product spec
                parsed = Math.round(parsed / 10000) * 10000;
            }
            state.principal = parsed;
            document.getElementById('principalInput').value = state.principal;
            refreshAllCalculations();
        }

        // Set preset WPS value on Tab 1
        function setWpsPreset(val) {
            state.wpsFinalPct = val;
            document.getElementById('wpsSlider').value = val;
            updateSimulator(val);
        }

        // Update Tab 1 Simulator
        function updateSimulator(val) {
            const wps = parseFloat(val);
            state.wpsFinalPct = wps;

            const wpsDisplay = document.getElementById('wpsValueDisplay');
            wpsDisplay.textContent = wps + '%';

            const P = state.principal;
            const totalCoupon = P * PRODUCT.total6MCouponRate; // 6 months full coupon for maturity simulation

            const outcomeCard = document.getElementById('outcomeCard');
            const outcomeBadge = document.getElementById('outcomeBadge');
            const outcomeTitle = document.getElementById('outcomeTitle');
            const outcomeDesc = document.getElementById('outcomeDesc');
            const simPrincipal = document.getElementById('simPrincipal');
            const simCoupon = document.getElementById('simCoupon');
            const simRedemption = document.getElementById('simRedemption');
            const simTotalValue = document.getElementById('simTotalValue');
            const simNetReturnPct = document.getElementById('simNetReturnPct');

            let redemptionValue = P;
            let fcnNetReturnPct = 5.48;
            const directStockReturnPct = wps - 100;

            if (wps >= 100) {
                // Early KO or Maturity >= 100%
                wpsDisplay.className = 'text-3xl font-black font-mono text-sky-400';
                outcomeCard.className = 'glass-card rounded-2xl p-5 sm:p-6 border-2 border-sky-500/60 transition-all';
                outcomeBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-500/30';
                outcomeBadge.textContent = '🚀 觸發 KO 出場條件 (≥ 100%)';
                outcomeTitle.textContent = `最差標的收在 ${wps}%（全數標的高於 100% 進場價）`;
                outcomeDesc.innerHTML = `所有連結標的皆表現強勁並超越進場價，觸發<strong>提前出場 (KO) 或到期安全贖回</strong>！客戶 100% 拿回美元本金與配息。（註：若於期中提前 KO，則領取至出場當期之配息）`;
            } else if (wps >= 70) {
                // Safe Zone (70% <= WPS < 100%)
                wpsDisplay.className = 'text-3xl font-black font-mono text-emerald-400';
                outcomeCard.className = 'glass-card rounded-2xl p-5 sm:p-6 border-2 border-emerald-500/60 transition-all';
                outcomeBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                outcomeBadge.textContent = '✅ 安全到期・100% 現金返還本金';
                outcomeTitle.textContent = `最差標的收在 ${wps}%（高於 70% 轉換價）`;
                outcomeDesc.innerHTML = `雖然最差股票下跌了 <strong>${100 - wps}%</strong>，但完全在安全防護網內！客戶到期 <strong class="text-emerald-300">100% 拿回美元本金</strong>，並領滿 6 個月高配息 (+5.48%)，大幅勝過直接買股！`;
            } else if (wps >= 65) {
                // Golden EKI Buffer Zone (65% <= WPS < 70%)
                wpsDisplay.className = 'text-3xl font-black font-mono text-amber-400';
                outcomeCard.className = 'glass-card rounded-2xl p-5 sm:p-6 border-2 border-amber-500/70 transition-all';
                outcomeBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40';
                outcomeBadge.textContent = '🛡️ 歐式 EKI 黃金緩衝區・依然 100% 保本！';
                outcomeTitle.textContent = `最差標的收在 ${wps}%（低於70%轉換價，但未破65% EKI）`;
                outcomeDesc.innerHTML = `<strong class="text-amber-300">這就是 EKI 65% 的價值所在！</strong>雖然最差標的收在 ${wps}%（低於 70% 轉換價），但因為期末<strong>沒有跌破 65% 下限價</strong>，所以<strong>不觸發接股</strong>！客戶依然 <strong class="text-emerald-300">100% 拿回現金本金 + 5.48% 全額配息</strong>！`;
            } else {
                // Knock-In Triggered (WPS < 65%) -> Physical Delivery at 70% Strike
                wpsDisplay.className = 'text-3xl font-black font-mono text-rose-400';
                outcomeCard.className = 'glass-card rounded-2xl p-5 sm:p-6 border-2 border-rose-500/70 transition-all';
                outcomeBadge.className = 'px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/40';
                outcomeBadge.textContent = '⚠️ 期末跌破 65% EKI・以 70% 轉換價承接股票';
                outcomeTitle.textContent = `最差標的收在 ${wps}%（跌破 65% EKI，啟動低接轉換）`;

                // Redemption market value = Principal * (WPS / 70)
                redemptionValue = P * (wps / PRODUCT.strikePct);
                const principalRatioPct = (wps / PRODUCT.strikePct) * 100;
                fcnNetReturnPct = (principalRatioPct - 100) + 5.48;

                outcomeDesc.innerHTML = `期末最差標的收低於 65%，觸發歐式 EKI。客戶將以 <strong class="text-amber-300">70% 轉換價（打7折）</strong>承接最差那檔股票。承接之股票市值約為本金的 <strong>${principalRatioPct.toFixed(2)}%</strong>，加上已領取的 <strong>5.48% 配息</strong>補貼，總表現仍比直接持有現股（${directStockReturnPct.toFixed(2)}%）少虧約 <strong>${(fcnNetReturnPct - directStockReturnPct).toFixed(2)}%</strong>！`;
            }

            const totalFinalValue = redemptionValue + totalCoupon;

            simPrincipal.textContent = formatUSD(P);
            simCoupon.textContent = '+' + formatUSD(totalCoupon);
            simRedemption.textContent = `${formatUSD(redemptionValue)} (${((redemptionValue / P) * 100).toFixed(1)}%)`;
            simTotalValue.textContent = formatUSD(totalFinalValue);
            simTotalValue.className = fcnNetReturnPct >= 0
                ? 'text-lg font-black font-mono text-emerald-400 block'
                : 'text-lg font-black font-mono text-rose-400 block';

            const sign = fcnNetReturnPct >= 0 ? '+' : '';
            const stockSign = directStockReturnPct >= 0 ? '+' : '';
            simNetReturnPct.textContent = `FCN 含息總報酬：${sign}${fcnNetReturnPct.toFixed(2)}% (對比直接買股 ${stockSign}${directStockReturnPct.toFixed(2)}%)`;
            simNetReturnPct.className = fcnNetReturnPct >= 0 ? 'text-xs font-mono text-emerald-300' : 'text-xs font-mono text-rose-300';

            // Update SVG Dynamic Marker
            // X maps 30%..130% to 50..580 (width 530, Wait: earlier lines used 5.5 per 1% from 50: 50 + (wps-30)*5.3? Let's match exact coordinates!)
            // In SVG: 65% is at x=242.5, 70% is at x=270, 100% is at x=435 -> scale is (w - 30) * 5.5 + 50 (for 30% to 126.3%)
            const svgX = Math.min(580, Math.max(50, 50 + (wps - 30) * 5.5));
            // Direct stock Y: 100% is y=110, 30% is y=250 -> y = 110 + (100 - wps) * 2
            const stockY = 110 + (100 - wps) * 2;
            // FCN Y: if wps >= 65 -> y = 99 (+5.48%). If wps < 65 -> y = 110 - fcnNetReturnPct * 2
            const fcnY = wps >= 65 ? 99 : (110 - fcnNetReturnPct * 2);

            document.getElementById('svgMarkerLine').setAttribute('x1', svgX);
            document.getElementById('svgMarkerLine').setAttribute('x2', svgX);
            document.getElementById('svgStockPoint').setAttribute('cx', svgX);
            document.getElementById('svgStockPoint').setAttribute('cy', stockY);

            const fcnCircle = document.getElementById('svgFcnPoint');
            fcnCircle.setAttribute('cx', svgX);
            fcnCircle.setAttribute('cy', fcnY);
            fcnCircle.setAttribute('fill', wps >= 65 ? '#10b981' : '#f43f5e');

            updateShareCalc();
        }

        // Update Share Conversion Calculator
        function updateShareCalc() {
            const initialPrice = parseFloat(document.getElementById('mockStockSelect').value);
            const strikePrice = initialPrice * (PRODUCT.strikePct / 100);
            const exactShares = state.principal / strikePrice;
            const wholeShares = Math.floor(exactShares);
            const fractionalShares = exactShares - wholeShares;
            // Fractional shares are settled in cash at final price
            const finalStockPrice = initialPrice * (state.wpsFinalPct / 100);
            const fractionalCash = fractionalShares * finalStockPrice;

            document.getElementById('convStrikePrice').textContent = `$${strikePrice.toFixed(2)} /股`;
            document.getElementById('convShareCount').textContent = `${wholeShares} 股 + 零股金 $${fractionalCash.toFixed(0)}`;
        }

        // Render & Calculate Tab 2 Memory KO Matrix
        function renderKoMatrix() {
            const tbody = document.getElementById('koMatrixBody');
            tbody.innerHTML = '';

            // Determine when each stock first gets "remembered" (only from Month 2 onwards, i.e., index >= 1)
            const firstMemoryMonth = {};
            PRODUCT.underlyings.forEach(sym => {
                firstMemoryMonth[sym] = null;
                for (let m = 1; m < 6; m++) {
                    if (state.koMatrix[sym][m]) {
                        firstMemoryMonth[sym] = m + 1; // 1-based month number (2..6)
                        break;
                    }
                }
            });

            // Determine overall Autocall (KO) month: when ALL 3 stocks have a firstMemoryMonth
            const allRemembered = PRODUCT.underlyings.every(sym => firstMemoryMonth[sym] !== null);
            const koMonth = allRemembered
                ? Math.max(...PRODUCT.underlyings.map(sym => firstMemoryMonth[sym]))
                : null;

            const badgeColors = {
                NVDA: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30',
                AVGO: 'bg-blue-500/20 text-blue-300 border-blue-500/30',
                NOW:  'bg-amber-500/20 text-amber-300 border-amber-500/30'
            };

            PRODUCT.underlyings.forEach(sym => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/40 transition';

                // Stock Name Cell
                const tdName = document.createElement('td');
                tdName.className = 'py-3.5 px-4 font-bold';
                tdName.innerHTML = `<span class="px-2.5 py-1 rounded border font-mono text-xs ${badgeColors[sym]}">${sym}</span>`;
                tr.appendChild(tdName);

                // 6 Month Cells
                for (let m = 0; m < 6; m++) {
                    const td = document.createElement('td');
                    td.className = 'py-3 px-2 text-center';
                    const isAbove100 = state.koMatrix[sym][m];
                    const monthNum = m + 1;

                    if (m === 0) {
                        // Month 1 Non-call period
                        td.innerHTML = `
                            <div class="inline-flex flex-col items-center px-2.5 py-1.5 rounded-lg bg-slate-900 text-slate-500 border border-slate-800 text-xs">
                                <span>閉鎖期</span>
                                <span class="text-[10px]">不觀察KO</span>
                            </div>
                        `;
                    } else {
                        const isRememberedHere = firstMemoryMonth[sym] !== null && monthNum >= firstMemoryMonth[sym];
                        const isFirstHit = firstMemoryMonth[sym] === monthNum;

                        let btnClass = '';
                        let statusHtml = '';

                        if (isAbove100) {
                            btnClass = 'bg-sky-500/25 border-sky-400 text-sky-200 hover:bg-sky-500/35';
                            statusHtml = `<span class="font-bold text-xs">≥ 100%</span><span class="text-[10px] text-sky-300 block">${isFirstHit ? '🔒 觸發記憶!' : '✅ 已記憶'}</span>`;
                        } else if (isRememberedHere) {
                            btnClass = 'bg-indigo-500/20 border-indigo-400/50 text-indigo-200 hover:bg-indigo-500/30';
                            statusHtml = `<span class="text-xs text-slate-300">&lt; 100%</span><span class="text-[10px] text-indigo-300 font-bold block">🧠 延續記憶過關</span>`;
                        } else {
                            btnClass = 'bg-slate-900 border-slate-700 text-slate-400 hover:bg-slate-800';
                            statusHtml = `<span class="text-xs">&lt; 100%</span><span class="text-[10px] text-slate-500 block">未達標</span>`;
                        }

                        td.innerHTML = `
                            <button onclick="toggleKoCell('${sym}', ${m})" class="w-full max-w-[105px] py-1.5 px-2 rounded-xl border transition ${btnClass}">
                                ${statusHtml}
                            </button>
                        `;
                    }
                    tr.appendChild(td);
                }

                // Memory Status Cell
                const tdStatus = document.createElement('td');
                tdStatus.className = 'py-3 px-4 text-center';
                if (firstMemoryMonth[sym] !== null) {
                    tdStatus.innerHTML = `<span class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold">✅ 第${firstMemoryMonth[sym]}月已記憶</span>`;
                } else {
                    tdStatus.innerHTML = `<span class="px-2.5 py-1 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/30 text-xs font-bold">⏳ 尚未達標</span>`;
                }
                tr.appendChild(tdStatus);

                tbody.appendChild(tr);
            });

            // Update KO Summary Banner
            const tag = document.getElementById('koStatusTag');
            const title = document.getElementById('koResultTitle');
            const exp = document.getElementById('koResultExplanation');
            const usdEl = document.getElementById('koTotalCouponUsd');
            const pctEl = document.getElementById('koTotalCouponPct');

            if (koMonth !== null) {
                const earnedMonths = koMonth;
                const earnedRate = PRODUCT.monthlyCouponRate * earnedMonths;
                const earnedUsd = state.principal * earnedRate;

                tag.className = 'inline-flex items-center gap-1.5 text-xs font-bold text-sky-300 bg-sky-500/20 px-2.5 py-0.5 rounded-full';
                tag.textContent = `🎉 第 ${koMonth} 個月觸發記憶型提前出場 (Memory KO)`;
                title.textContent = `於「第 ${koMonth} 個月」3 檔標的皆完成記憶，商品提前出場拿回 100% 本金！`;
                exp.innerHTML = `各標的達標記憶月份：NVDA (第${firstMemoryMonth.NVDA}月)、AVGO (第${firstMemoryMonth.AVGO}月)、NOW (第${firstMemoryMonth.NOW}月)。即使先前達標的股票在第 ${koMonth} 個月跌回 100% 以下，靠著<strong>「記憶機制」</strong>依然算數，客戶順利於第 ${koMonth} 個月提前落袋為安！`;
                usdEl.textContent = formatUSD(earnedUsd);
                pctEl.textContent = `實拿累積配息率：+${(earnedRate * 100).toFixed(2)}% (共領 ${earnedMonths} 個月)`;
            } else {
                const missing = PRODUCT.underlyings.filter(s => firstMemoryMonth[s] === null).join('、');
                const fullUsd = state.principal * PRODUCT.total6MCouponRate;

                tag.className = 'inline-flex items-center gap-1.5 text-xs font-bold text-emerald-300 bg-emerald-500/20 px-2.5 py-0.5 rounded-full';
                tag.textContent = '⏳ 未觸發提前出場・持續領息至 6 個月期滿';
                title.textContent = `因 ${missing} 尚未觸及 100%，商品不會提前出場，客戶可領滿 6 個月高息！`;
                exp.innerHTML = `只要有任一檔股票未曾站上 100%，契約就會持續進行，這對想<strong>「領滿 6 個月 10.96% 年化高息」</strong>的客戶反而更划算！只要最後一天最差標的沒有跌破 65% EKI，客戶就能把 6 期配息全部領滿並拿回 100% 本金。`;
                usdEl.textContent = formatUSD(fullUsd);
                pctEl.textContent = `滿期 6 個月總配息率：+5.48% (共領 6 個月)`;
            }
        }

        function toggleKoCell(sym, monthIdx) {
            state.koMatrix[sym][monthIdx] = !state.koMatrix[sym][monthIdx];
            renderKoMatrix();
        }

        function loadKoScenario(type) {
            if (type === 'staggered') {
                state.koMatrix = {
                    NVDA: [true, true, false, false, false, false],
                    AVGO: [false, false, true, false, false, false],
                    NOW:  [false, false, true, true, false, false]
                };
            } else {
                state.koMatrix = {
                    NVDA: [true, true, true, false, false, false],
                    AVGO: [false, true, false, true, false, false],
                    NOW:  [false, false, false, false, false, false]
                };
            }
            renderKoMatrix();
        }

        // Update Header & Sales Pitch Textarea
        function refreshAllCalculations() {
            const P = state.principal;
            const monthlyUsd = P * PRODUCT.monthlyCouponRate;
            const total6MUsd = P * PRODUCT.total6MCouponRate;

            document.getElementById('headerMonthlyCoupon').textContent = formatUSD(monthlyUsd);
            document.getElementById('headerTotalCoupon').textContent = formatUSD(total6MUsd);

            updateSimulator(state.wpsFinalPct);
            renderKoMatrix();
            generateSalesPitch();
        }

        function generateSalesPitch() {
            const P = state.principal;
            const monthlyUsd = formatUSD(P * PRODUCT.monthlyCouponRate);
            const total6MUsd = formatUSD(P * PRODUCT.total6MCouponRate);
            const pFormatted = Number(P).toLocaleString('en-US');

            const pitch = `【📢 精選 AI 龍頭美元 FCN 固定配息專案｜代號：SNINR202610013】

您好！跟您分享一檔條件非常漂亮、攻守兼備的 6 個月期美元結構型商品：
🔹 連結標的：輝達 (NVDA) + 博通 (AVGO) + ServiceNow (NOW)
🔹 天期 / 幣別：6 個月 / 美元 (USD)
🔹 固定年化配息率：10.96%（每月配息約 0.9133%，半年總息 5.48%）
🔹 轉換價 (Strike)：進場收盤價之 70%（相當於打 7 折安全墊）
🔹 下限價 (KI)：65% 歐式觀察 (EKI) —— 盤中震盪跌破不算，只看最後一天！
🔹 提前出場 (KO)：100%，滿 1 個月後每日觀察且具「記憶機制」

💡【以申購 ${pFormatted} 美元試算】
✅ 每月穩定領息：約 ${monthlyUsd} 美元（若領滿 6 個月共領息 ${total6MUsd} 美元）
✅ 為什麼推薦這檔結構？
1️⃣「記憶型 KO」好出場：滿 1 個月後，3 檔股票不需要同一天漲過 100%，只要各自在不同天曾經回到進場價一次就會被系統「記憶」，3 檔都記憶即提前出場拿回 100% 本金＋利息！
2️⃣「歐式 EKI 65%」深度防護：前 6 個月期間就算遇到大盤修正跌破 65% 也完全不影響，只要期末最後一天最差標的收在 65% 以上（含 65%~70% 區間），依然 100% 拿回美元本金！
3️⃣ 進可攻退可守：僅在期末最後一天最差股票跌破 65% 時，才會以「70% 轉換價（打 7 折）」折算承接 AI 龍頭股。

⚠️ 風險提醒：本商品非保本型商品，最大風險為期末最差標的跌破 65% 時需依 70% 轉換價承接股票，並需留意發行機構信用風險與流動性風險。若您想看不同股價情境的損益試算，我隨時為您說明！`;

            document.getElementById('pitchTextarea').value = pitch;
        }

        function copyPitchText() {
            const textarea = document.getElementById('pitchTextarea');
            textarea.select();
            textarea.setSelectionRange(0, 99999);
            try {
                document.execCommand('copy');
                showToast('✅ LINE 提案話術已複製到剪貼簿！');
            } catch (err) {
                showToast('請手動全選複製文字');
            }
        }

        function showToast(msg) {
            const box = document.getElementById('toastBox');
            document.getElementById('toastMsg').textContent = msg;
            box.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                box.classList.add('translate-y-20', 'opacity-0');
            }, 2600);
        }

        // Initialize on Window Load
        window.onload = function () {
            refreshAllCalculations();
        };
    </script>
</body>
</html>
